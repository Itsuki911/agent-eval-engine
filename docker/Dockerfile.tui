FROM golang:1.24-alpine AS cli-builder

# Go CLIをビルドする
WORKDIR /build
COPY apps/cli/go.mod apps/cli/go.sum ./
RUN go mod download
COPY apps/cli/ ./
RUN go build -o /out/agent-eval .

FROM python:3.12-slim

# 評価エンジンを無バッファで動かす
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace
COPY requirements-engine.txt requirements-db.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-engine.txt
COPY --from=cli-builder /out/agent-eval /usr/local/bin/agent-eval

ENTRYPOINT ["agent-eval"]
