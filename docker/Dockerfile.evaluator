FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

COPY requirements-evaluator.txt /tmp/requirements-evaluator.txt
RUN pip install --no-cache-dir -r /tmp/requirements-evaluator.txt

COPY scripts/validate_phase1.py /workspace/scripts/validate_phase1.py
COPY schemas /workspace/schemas
COPY benchmarks /workspace/benchmarks
COPY fixtures /workspace/fixtures

ENTRYPOINT ["python", "scripts/validate_phase1.py"]
