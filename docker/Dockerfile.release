# Agent Eval Engine - GHCR 配布用 Dockerfile
FROM python:3.12-slim

# 実行ログの即時フラッシュ
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/workspace:/workspace/packages/core"

WORKDIR /workspace

# 依存パッケージのインストール
COPY requirements-engine.txt requirements-db.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-engine.txt

# アプリケーションコード・設定・マイグレーション・ベンチマークのコピー
COPY alembic.ini /workspace/
COPY packages /workspace/packages
COPY database /workspace/database
COPY scripts /workspace/scripts
COPY benchmarks /workspace/benchmarks
COPY fixtures /workspace/fixtures
COPY apps /workspace/apps
COPY configs /workspace/configs

# 非特権ユーザーまたは作業用ディレクトリの権限設定
RUN mkdir -p /workspace/local-data /workspace/exports /workspace/logs

CMD ["python", "scripts/tui_backend.py", "--help"]
