{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-eval.example/schemas/benchmark.schema.json",
  "title": "Agent Evaluation Benchmark",
  "type": "object",
  "required": ["schema_version", "id", "title", "family", "category", "fixture", "task", "expected"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^(GEN|COD|TERM|WEB|GUI)-[A-Z0-9]+-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "enum": ["generic", "coding", "terminal", "web", "gui"] },
    "category": { "type": "string", "enum": ["task_success", "tool_selection", "tool_execution", "recovery", "robustness", "safety", "bug_fix", "code_generation", "test_fix", "refactoring", "repository_understanding"] },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "fixture": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*-v[0-9]+$" },
    "task": {
      "type": "object",
      "required": ["prompt"],
      "properties": { "prompt": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "task_version": { "type": "integer", "minimum": 1 },
        "split": { "type": "string", "enum": ["dev", "test", "heldout"] },
        "source": { "type": "string" },
        "contamination_risk": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
        "human_review": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "additionalProperties": false
    },
    "constraints": { "type": "object" },
    "expected": { "type": "object", "required": ["success_conditions"], "properties": { "success_conditions": { "type": "array", "minItems": 1 }, "failure_conditions": { "type": "array" } } },
    "evaluation": {
      "type": "object",
      "properties": {
        "required_metrics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "trace": { "type": "object" }
      },
      "additionalProperties": false
    },
    "limits": { "type": "object", "properties": { "max_steps": { "type": "integer", "minimum": 1 }, "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 }, "max_estimated_cost_usd": { "type": "number", "minimum": 0 } } },
    "status": { "type": "string", "enum": ["draft", "active", "deprecated"] }
  },
  "additionalProperties": false
}
